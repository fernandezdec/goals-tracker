# Goals Tracker — Environment Variables
# Copy this to .env and fill in your values

# Port the API listens on (inside Docker — don't change unless you update docker-compose.yml)
PORT=3031

# SQLite database path (mounted volume)
DB_PATH=/data/goals.db

# JWT secret — used to sign local session tokens
# Generate: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret

# SSO JWT secret — MUST match the GOALS_JWT_SECRET set in coach-fern-auth
# This is the secret used to verify tokens from login.coachfern.net
# Generate: openssl rand -hex 32
SSO_JWT_SECRET=change-this-to-match-goals-jwt-secret-in-auth-service

# Bootstrap admin (created on first run if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Steelers1!
